# Copy to .env and fill in. Never commit .env.

# Venice (default model: venice-uncensored-role-play). Get a key at https://venice.ai/settings/api
VENICE_API_KEY=

# Optional extra providers (enable them in models.json)
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=

PORT=8787
DB_PATH=realms.db

# Which models.json entry is used when a player hasn't picked one
DEFAULT_MODEL=venice-rp

# Optional: a separate (cheaper/more reliable at JSON) model for state extraction.
# Adult-rated text is only ever sent to models flagged "adultContent": true.
EXTRACTOR_MODEL=

# Browser clients only; use your app's origin in production
CORS_ORIGIN=*
